# ==============================================================================
# Smart RMS - Environment Configuration Template
# ==============================================================================

# Core Application
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Provider Settings
# Options: mock, gemini
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
AI_CONFIDENCE_THRESHOLD=0.75

# Privacy & Security
ENABLE_PII_REDACTION=True
PII_MASK_CHARACTER=*
AUDIT_LOG_ENABLED=True

# RAG & Vector Storage
# Options: mock, chroma
VECTOR_STORE_TYPE=mock
CHROMA_PERSIST_DIRECTORY=./chroma_data
EMBEDDING_MODEL=text-embedding-004

# Integration Adapter Mode
# Options: mock, ums_staging
INTEGRATION_MODE=mock

# Database (Planned / Production)
DATABASE_URL=postgresql://smart_rms_user:smart_rms_pass@localhost:5432/smart_rms_db
REDIS_URL=redis://localhost:6379/0
