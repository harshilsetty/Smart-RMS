ENVIRONMENT=production
DEBUG=False
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI & ML Configuration
AI_PROVIDER=mock
NLP_MODEL_PROVIDER=deterministic
CLAIM_VERIFIER_PROVIDER=deterministic
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-xsmall
AI_CONFIDENCE_THRESHOLD=0.75

# Vector Store
VECTOR_STORE_TYPE=mock
CHROMA_PERSIST_DIRECTORY=./chroma_data
EMBEDDING_MODEL=text-embedding-004

# Integration & University Systems
# Use "mock" for synthetic testing. Future integration will use "lpu"
INTEGRATION_MODE=mock
# LPU_API_KEY=your_lpu_integration_key_here

# Privacy Settings
ENABLE_PII_REDACTION=True
PII_MASK_CHARACTER=*
AUDIT_LOG_ENABLED=True

# Secrets (DO NOT COMMIT ACTUAL VALUES)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
